<?php

declare(strict_types=1);

namespace Modules\__STUDLY__\Services;

use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;
use Illuminate\Validation\ValidationException;
use Modules\__STUDLY__\Contracts\Services\__STUDLY__ServiceInterface;
use Modules\__STUDLY__\Models\__STUDLY__;
use Modules\__STUDLY__\Models\__TRANSLATION_CLASS__;

class __STUDLY__DomainService implements __STUDLY__ServiceInterface
{
    public function create(array $data): __STUDLY__
    {
        return DB::transaction(function () use ($data): __STUDLY__ {
            /** @var __STUDLY__ $item */
            $item = __STUDLY__::create([
                'is_active' => (bool) ($data['is_active'] ?? true),
                'order' => (int) ($data['order'] ?? 0),
            ]);

            $this->syncTranslations($item, $this->normalizeTranslations($data));
            $this->syncMarkets($item, $data);

            return $item;
        });
    }

    public function update(__STUDLY__ $item, array $data): __STUDLY__
    {
        return DB::transaction(function () use ($item, $data): __STUDLY__ {
            $item->update([
                'is_active' => (bool) ($data['is_active'] ?? $item->is_active),
                'order' => (int) ($data['order'] ?? $item->order),
            ]);

            $this->syncTranslations($item, $this->normalizeTranslations($data));
            $this->syncMarkets($item, $data);

            return $item->fresh() ?? $item;
        });
    }

    public function delete(__STUDLY__ $item): bool
    {
        return DB::transaction(static fn (): bool => (bool) $item->delete());
    }

    public function paginate(int $perPage = 15): LengthAwarePaginator
    {
        return __STUDLY__::with(['translations', 'markets'])->latest()->paginate($perPage);
    }

    /**
     * @param array<string, mixed> $data
     * @return array<string, array{title: string, slug: string, content: string|null}>
     */
    private function normalizeTranslations(array $data): array
    {
        $translations = [];
        /** @var array<string, mixed> $payloads */
        $payloads = (array) ($data['translations'] ?? []);

        foreach ($payloads as $locale => $payload) {
            if (! is_array($payload) || empty($payload['title'])) {
                continue;
            }

            $title = (string) $payload['title'];
            $translations[(string) $locale] = [
                'title' => $title,
                'slug' => ! empty($payload['slug']) ? Str::slug((string) $payload['slug']) : Str::slug($title),
                'content' => ! empty($payload['content']) ? (string) $payload['content'] : null,
            ];
        }

        if ($translations === []) {
            throw ValidationException::withMessages([
                'translations' => 'Define al menos el título en un idioma.',
            ]);
        }

        return $translations;
    }

    /**
     * @param array<string, array{title: string, slug: string, content: string|null}> $translations
     */
    private function syncTranslations(__STUDLY__ $item, array $translations): void
    {
        foreach ($translations as $locale => $payload) {
            __TRANSLATION_CLASS__::updateOrCreate(
                ['__FK__' => $item->getKey(), 'locale' => $locale, 'market_id' => null],
                $payload
            );
        }
    }

    /**
     * @param array<string, mixed> $data
     */
    private function syncMarkets(__STUDLY__ $item, array $data): void
    {
        if (! array_key_exists('market_ids', $data)) {
            return;
        }

        $item->markets()->sync(array_map('intval', (array) $data['market_ids']));
    }
}