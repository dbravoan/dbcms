{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeatureSpecSchema",
  "type": "object",
  "required": ["feature_id", "title", "preconditions", "postconditions", "test_invariants"],
  "properties": {
    "feature_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "dtos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "properties"],
        "properties": {
          "name": { "type": "string" },
          "properties": { "type": "object" }
        }
      }
    },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "postconditions": { "type": "array", "items": { "type": "string" } },
    "test_invariants": { "type": "array", "items": { "type": "string" } },
    "geo_metadata": { "type": "object" },
    "passport_scopes": { "type": "array", "items": { "type": "string" } }
  }
}
