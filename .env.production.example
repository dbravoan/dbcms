# =============================================================================
# dbCMS - Plantilla de entorno para PRODUCCIÓN (VPS Ubuntu + Plesk, sin Docker)
# -----------------------------------------------------------------------------
# Copiar a <APP_DIR>/.env en el VPS y rellenar los valores reales.
# NUNCA subir el .env relleno al repositorio.
# =============================================================================

APP_NAME="dbCMS"
# CMS Brand: single source of truth for the backoffice theme + brand identity.
# Must match a directory under resources/views/themes/admin/ ('dbcms' or 'termocms').
CMS_BRAND=dbcms
# Front-office theme (directory under themes/). Switchable from the backoffice Themes page.
CMS_THEME=db-cyber
# Max public (unauthenticated) POSTs per minute and IP (forms, comments, shop, geo)
CMS_PUBLIC_WRITES_PER_MINUTE=30
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos MySQL/MariaDB del VPS (socket/local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbcms
DB_USERNAME=dbcms
DB_PASSWORD=

# Sesiones / caché / colas.
# Por defecto 'database' (no requiere Redis). Si el VPS tiene Redis, usar
# SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis y ajustar REDIS_HOST.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo saliente real (SMTP del hosting / proveedor)
MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-dominio.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Passport: dejar vacío para usar storage/oauth-*.key (persistente),
# o pegar aquí las claves PEM si el hosting no permite escribir en storage.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Generative Engine Optimization (GEO) & SEO
GEO_ENABLED=true
GEO_SITE_NAME="dbCMS"
GEO_SITE_DESCRIPTION="Plataforma CMS Modular y Agéntica Multi-Mercado"
GEO_AUTHOR="dbCMS"
GEO_LLMS_TXT_MAX_TOKENS=2048
