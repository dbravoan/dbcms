includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    configDirectories:
        - config/
        - modules/*/Config/
    bootstrapFiles:
        - bootstrap/phpstan.php
    paths:
        - app/
        - modules/
        - block-packages/
        - config/
        - database/
        - routes/
        - bootstrap/RuntimeEnvironmentBootstrap.php

    # Level 8 provides complete static typing and analysis for Laravel applications
    level: 8

    treatPhpDocTypesAsCertain: false
