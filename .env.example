APP_NAME="dbCMS"

# ---------------------------------------------------------------------------
# Theme selection (see docs/18_THEME_MANIFEST_AND_BRAND_REFERENCE.md)
# ---------------------------------------------------------------------------
# Backoffice theme: must match a directory under resources/views/themes/admin/.
# The brand identity (name, tagline, logo, icon, edition, accent) is declared in
# that theme's theme.json — never here.
CMS_BRAND=dbcms
# Front-office (public) theme: directory under themes/.
CMS_THEME=db-cyber
# Optional global tagline override. Leave empty to use the theme's brand.tagline.
CMS_TAGLINE=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Stable per-installation identity; blank derives from the persistent APP_KEY.
CMS_INSTALLATION_ID=
MARKETING_MAX_ARTIFACT_BYTES=536870912
MARKETING_GENERATION_CONCURRENCY=2

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Generative Engine Optimization (GEO) & SEO
GEO_ENABLED=true
GEO_SITE_NAME="dbCMS"
GEO_SITE_DESCRIPTION="CMS empresarial modular multi-mercado con servidor MCP nativo para agentes de IA"
GEO_AUTHOR="dbCMS Core Team"
GEO_LLMS_TXT_MAX_TOKENS=2048

# AI Providers (optional env fallback; keys can also be saved from the backoffice)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# OpenCode: a single API key unlocks both the Zen and Go model catalogs
OPENCODE_API_KEY=

# Local-only 1-click persona switcher (never enable outside local)
CMS_QUICK_LOGIN=false
CMS_SEED_DEMO=false

# Max public (unauthenticated) POSTs per minute and IP (forms, comments, shop, geo)
CMS_PUBLIC_WRITES_PER_MINUTE=30
