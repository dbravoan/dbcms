#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "$ROOT_DIR"
if [ "$#" -eq 0 ]; then
    echo "Usage: bin/sail-run <php|composer|pest|phpstan|pint|command> [arguments]" >&2
    exit 64
fi
case "$1" in
    pest|phpstan|pint) command_name="$1"; shift; set -- "vendor/bin/$command_name" "$@" ;;
    artisan) shift; set -- php artisan "$@" ;;
esac
if [ -f /.dockerenv ]; then
    exec "$@"
fi
command -v docker >/dev/null 2>&1 || { echo 'Docker is required.' >&2; exit 1; }
if docker compose ps --services --filter status=running | grep -qx laravel.test; then
    exec docker compose exec -T laravel.test "$@"
fi
exec docker compose run --rm -T laravel.test "$@"
