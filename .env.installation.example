APP_NAME="dbCMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Madrid
APP_URL=http://localhost

CMS_BRAND=dbcms
CMS_THEME=db-cyber
CMS_INSTALLATION_ID=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbcms
DB_USERNAME=dbcms
DB_PASSWORD=

# Estos controladores no necesitan tablas durante el asistente.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

GEO_ENABLED=true
GEO_SITE_NAME="dbCMS"
GEO_SITE_DESCRIPTION="CMS modular multi-mercado"
GEO_AUTHOR="dbCMS"
GEO_LLMS_TXT_MAX_TOKENS=2048

CMS_PUBLIC_WRITES_PER_MINUTE=30
